        "type": "dashboard"
      }
    ]
  },
  "description": "AKS cluster health: node readiness and pressure, problem pods, and Prometheus alert checks",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Core Kubernetes – AKS",
      "type": "link",
      "url": "/d/aks-core-k8s",
      "includeVars": true,
      "keepTime": true,
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Node Health",
