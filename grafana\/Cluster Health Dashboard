      }
    },
    {
      "type": "stat",
      "title": "Unscheduled Pods",
      "description": "Pending pods that have not been assigned to a node, usually insufficient CPU/memory, taints, or affinity rules",
      "id": 9,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (cluster) (kube_pod_info{node=\"\", cluster=~\"$cluster\"} * on (cluster, namespace, pod) group_left() (kube_pod_status_phase{phase=\"Pending\", cluster=~\"$cluster\"} == 1)) or sum by (cluster) (kube_pod_status_phase{phase=\"Pending\", cluster=~\"$cluster\"}) * 0",
          "legendFormat": "{{cluster}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "timeseries",
      "title": "Pending / Failed / Unscheduled Over Time",
      "id": 10,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster) (kube_pod_status_phase{phase=\"Pending\", cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}} – Pending",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster) (kube_pod_status_phase{phase=\"Failed\", cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}} – Failed",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (cluster) (kube_pod_info{node=\"\", cluster=~\"$cluster\"} * on (cluster, namespace, pod) group_left() (kube_pod_status_phase{phase=\"Pending\", cluster=~\"$cluster\"} == 1)) or sum by (cluster) (kube_pod_status_phase{phase=\"Pending\", cluster=~\"$cluster\"}) * 0",
          "legendFormat": "{{cluster}} – Unscheduled",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "table",
      "title": "Problem Pods (Pending / Failed)",
      "description": "Current Pending and Failed pods. 'Node' is empty when the pod is unscheduled.",
      "id": 11,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(kube_pod_status_phase{phase=~\"Pending|Failed\", cluster=~\"$cluster\"} == 1) * on (cluster, namespace, pod) group_left(node) max by (cluster, namespace, pod, node) (kube_pod_info{cluster=~\"$cluster\"})",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "uid": true,
              "service": true,
              "endpoint": true
            },
            "indexByName": {
              "cluster": 0,
              "namespace": 1,
              "pod": 2,
              "phase": 3,
              "node": 4
            },
            "renameByName": {
              "cluster": "Cluster",
              "namespace": "Namespace",
              "pod": "Pod",
              "phase": "Phase",
              "node": "Node"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Phase"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Pending": {
                        "color": "orange",
                        "index": 0
                      },
                      "Failed": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "count"
          ],
          "countRows": true
        }
      }
    },
    {
      "type": "row",
      "title": "Cluster Alerts",
      "collapsed": false,
      "id": 12,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Fired Azure Alerts by Severity",
      "description": "Open Azure Monitor alerts in the selected subscription (includes Prometheus rule group alerts and the AKS recommended alerts)",
      "id": 13,
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${azure_monitor}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${azure_monitor}"
          },
          "queryType": "Azure Resource Graph",
          "subscriptions": [
            "$subscription"
          ],
          "azureResourceGraph": {
            "query": "alertsmanagementresources\n| where type =~ 'microsoft.alertsmanagement/alerts'\n| where tostring(properties.essentials.monitorCondition) =~ 'Fired'\n| where tostring(properties.essentials.alertState) !~ 'Closed'\n| extend Severity = tostring(properties.essentials.severity)\n| summarize Count = count() by Severity\n| order by Severity asc",
            "resultFormat": "table"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Sev0"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sev1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sev2"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sev3"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sev4"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "Severity",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "Count",
                "handlerKey": "field.value"
              }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
