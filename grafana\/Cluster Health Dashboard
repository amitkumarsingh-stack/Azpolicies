      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster) (kube_pod_status_phase{phase=\"Pending\", cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}}",
          "range": true,
