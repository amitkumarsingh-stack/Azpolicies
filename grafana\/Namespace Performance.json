          },
          "expr": "topk(10, sum by (cluster, namespace) (container_memory_working_set_bytes{container!=\"\", container!=\"POD\", cluster=~\"$cluster\", namespace=~\"$namespace\"}))",
          "legendFormat": "{{cluster}} / {{namespace}}",
          "range": false,
